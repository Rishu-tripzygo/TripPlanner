// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  name            String?
  username        String?           @unique
  bio             String?
  location        String?
  coverImageUrl   String?
  isPublicProfile Boolean           @default(true)
  email           String            @unique
  emailVerified   DateTime?
  image           String?
  themePreference ThemePreference @default(SYSTEM)
  accounts        Account[]
  sessions        Session[]
  trips           Trip[]
  tripCollaborations TripCollaborator[]
  chatMessages    ChatMessage[]
  notifications   Notification[]
  bookmarks       TripBookmark[]
  reactions       TripReaction[]
  following       Follow[]          @relation("UserFollowing")
  followers       Follow[]          @relation("UserFollowers")
  guestPreviews   GuestPreview[]
  generationRequests GenerationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                Int      @id @default(autoincrement())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model GuestPreview {
  id              String   @id @default(cuid())
  sessionToken    String   @unique
  publicToken     String   @unique
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  destination     String
  plannerInput    Json
  itineraryData   Json
  sourceProvider  String
  title           String?
  expiresAt       DateTime
  claimedAt       DateTime?
  convertedTripId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
  @@index([userId, claimedAt])
}

model Trip {
  id String @id @default(cuid())
  title String
  description String
  imageUrl String?
  startDate DateTime
  endDate DateTime
  routeStatus RouteStatus @default(NOT_STARTED)
  routeSourceVersionId String?
  routeUpdatedAt DateTime?
  originLabel String?
  originLat Float?
  originLng Float?
  returnToOrigin Boolean @default(true)
  user User @relation(fields: [userId], references: [id] )
  userId String

  locations Location[]
  budget Budget?
  expenses Expense[]
  packingList PackingList?
  documents Document[]
  journalEntries JournalEntry[]
  itineraryVersions ItineraryVersion[]
  chatMessages ChatMessage[]
  share TripShare?
  generationRequests GenerationRequest[]
  collaborators TripCollaborator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GenerationRequest {
  id             String                  @id @default(cuid())
  userId         String?
  user           User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tripId         String?
  trip           Trip?                   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  requestType    GenerationRequestType
  status         GenerationRequestStatus @default(QUEUED)
  providerOrder  Json
  attemptLog     Json?
  requestPayload Json
  promptSnapshot String?
  providerUsed   String?
  resultMeta     Json?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([tripId, createdAt])
  @@index([status, createdAt])
}

model Location {
  id String @id @default(cuid())
  locationTitle String
  lat Float
  lng Float
  trip Trip @relation(fields: [tripId], references: [id] )
  tripId String
  order Int @default(0)
  notes Note[]
  createdAt DateTime @default(now())
}

model Budget {
  id           String   @id @default(cuid())
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId       String   @unique
  totalBudget  Float
  currency     String   @default("INR")
  accommodation Float   @default(0)
  food         Float    @default(0)
  transport    Float    @default(0)
  activities   Float    @default(0)
  misc         Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  name      String
  amount    Float
  category  ExpenseCategory
  expenseDate DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, expenseDate])
}

model WeatherCache {
  id          String   @id @default(cuid())
  destination String
  date        DateTime
  data        Json
  cachedAt    DateTime @default(now())

  @@unique([destination, date])
}

model PackingList {
  id        String   @id @default(cuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String   @unique
  template  String?
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id         String   @id @default(cuid())
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId     String
  name       String
  type       String
  url        String
  expiryDate DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tripId, createdAt])
}

model Note {
  id           String   @id @default(cuid())
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId   String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([locationId, createdAt])
}

model JournalEntry {
  id        String   @id @default(cuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  day       Int
  content   String
  photos    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, day])
  @@index([tripId, createdAt])
}

model ItineraryVersion {
  id             String   @id @default(cuid())
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId         String
  versionNumber  Int
  sourceProvider String
  sourcePrompt   String?
  title          String?
  itineraryData  Json
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  chatMessages   ChatMessage[]

  @@unique([tripId, versionNumber])
  @@index([tripId, isActive])
}

model ChatMessage {
  id                 String            @id @default(cuid())
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  trip               Trip?             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId             String?
  itineraryVersion   ItineraryVersion? @relation(fields: [itineraryVersionId], references: [id], onDelete: Cascade)
  itineraryVersionId String?
  role               ChatRole
  content            String
  createdAt          DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([tripId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  tripId    String?
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model TripShare {
  id        String         @id @default(cuid())
  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String         @unique
  token     String         @unique
  isPublic  Boolean        @default(false)
  bookmarks TripBookmark[]
  reactions TripReaction[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model TripCollaborator {
  id          String           @id @default(cuid())
  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  email       String
  role        CollaboratorRole @default(VIEWER)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tripId, userId])
  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model TripBookmark {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tripShare   TripShare @relation(fields: [tripShareId], references: [id], onDelete: Cascade)
  tripShareId String
  createdAt   DateTime  @default(now())

  @@unique([userId, tripShareId])
  @@index([tripShareId, createdAt])
}

model TripReaction {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tripShare   TripShare @relation(fields: [tripShareId], references: [id], onDelete: Cascade)
  tripShareId String
  createdAt   DateTime  @default(now())

  @@unique([userId, tripShareId])
  @@index([tripShareId, createdAt])
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum CollaboratorRole {
  OWNER
  EDITOR
  VIEWER
}

enum ExpenseCategory {
  ACCOMMODATION
  FOOD
  TRANSPORT
  ACTIVITIES
  MISC
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum GenerationRequestType {
  ITINERARY
  REFINE
  GUEST_PREVIEW
}

enum GenerationRequestStatus {
  QUEUED
  GENERATING
  FORMATTING
  SAVING
  COMPLETED
  FAILED
}

enum RouteStatus {
  NOT_STARTED
  SUGGESTED
  CONFIRMED
  STALE
}
