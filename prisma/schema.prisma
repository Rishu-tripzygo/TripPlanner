// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  themePreference ThemePreference @default(SYSTEM)
  accounts      Account[]
  sessions      Session[]
  trips         Trip[]
  chatMessages  ChatMessage[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                Int      @id @default(autoincrement())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Trip {
  id String @id @default(cuid())
  title String
  description String
  imageUrl String?
  startDate DateTime
  endDate DateTime
  user User @relation(fields: [userId], references: [id] )
  userId String

  locations Location[]
  budget Budget?
  expenses Expense[]
  packingList PackingList?
  documents Document[]
  journalEntries JournalEntry[]
  itineraryVersions ItineraryVersion[]
  chatMessages ChatMessage[]
  share TripShare?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id String @id @default(cuid())
  locationTitle String
  lat Float
  lng Float
  trip Trip @relation(fields: [tripId], references: [id] )
  tripId String
  order Int @default(0)
  notes Note[]
  createdAt DateTime @default(now())
}

model Budget {
  id           String   @id @default(cuid())
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId       String   @unique
  totalBudget  Float
  currency     String   @default("INR")
  accommodation Float   @default(0)
  food         Float    @default(0)
  transport    Float    @default(0)
  activities   Float    @default(0)
  misc         Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  name      String
  amount    Float
  category  ExpenseCategory
  expenseDate DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, expenseDate])
}

model WeatherCache {
  id          String   @id @default(cuid())
  destination String
  date        DateTime
  data        Json
  cachedAt    DateTime @default(now())

  @@unique([destination, date])
}

model PackingList {
  id        String   @id @default(cuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String   @unique
  template  String?
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id         String   @id @default(cuid())
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId     String
  name       String
  type       String
  url        String
  expiryDate DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tripId, createdAt])
}

model Note {
  id           String   @id @default(cuid())
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId   String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([locationId, createdAt])
}

model JournalEntry {
  id        String   @id @default(cuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  day       Int
  content   String
  photos    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, day])
  @@index([tripId, createdAt])
}

model ItineraryVersion {
  id             String   @id @default(cuid())
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId         String
  versionNumber  Int
  sourceProvider String
  sourcePrompt   String?
  title          String?
  itineraryData  Json
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  chatMessages   ChatMessage[]

  @@unique([tripId, versionNumber])
  @@index([tripId, isActive])
}

model ChatMessage {
  id                 String            @id @default(cuid())
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  trip               Trip?             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId             String?
  itineraryVersion   ItineraryVersion? @relation(fields: [itineraryVersionId], references: [id], onDelete: Cascade)
  itineraryVersionId String?
  role               ChatRole
  content            String
  createdAt          DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([tripId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  tripId    String?
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model TripShare {
  id        String   @id @default(cuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String   @unique
  token     String   @unique
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum ExpenseCategory {
  ACCOMMODATION
  FOOD
  TRANSPORT
  ACTIVITIES
  MISC
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}
